{
    "$comment": [
        "Single source of truth for dev-setup. See README.md for the full reference.",
        "'user' holds the knobs meant for routine editing.",
        "'advanced' holds shared/derived values - correct by default, change only with reason."
    ],
    "user": {
        "install": {
            "homebrew": true,
            "git": true,
            "githubCli": true,
            "node": true,
            "prettier": true,
            "python": true,
            "rust": true,
            "dioxus": true,
            "php": true,
            "powershell": true,
            "shellcheck": true,
            "ripgrep": true,
            "busybox": true,
            "packer": true,
            "gpg": true,
            "vscodeSettings": true,
            "devcontainerDefaults": true,
            "mcpServers": true
        },
        "checkUpgrades": true,
        "git": {
            "installDir": "",
            "forcePortable": false,
            "userName": "",
            "userEmail": ""
        },
        "python": {
            "version": "3.14",
            "allowGlobalPackageInstalls": false,
            "recommendedVirtualEnvironment": ".venv"
        },
        "rust": {
            "components": ["rustfmt", "clippy", "rust-src"],
            "targets": []
        },
        "vscode": {
            "profiles": ["stable", "insiders"],
            "settingsSync": {
                "syncAfterSetup": true,
                "requiredProvider": "github"
            },
            "copilot": {
                "autoAcceptDelay": 1,
                "autopilot": false,
                "fusion": false
            },
            "terminalInstructions": {
                "manage": true
            },
            "extensions": {
                "manage": true,
                "uninstallBlocked": true,
                "install": [
                    "charliermarsh.ruff",
                    "davidanson.vscode-markdownlint",
                    "dbaeumer.vscode-eslint",
                    "editorconfig.editorconfig",
                    "esbenp.prettier-vscode",
                    "github.vscode-github-actions",
                    "github.vscode-pull-request-github",
                    "hashicorp.hcl",
                    "ms-azuretools.vscode-containers",
                    "ms-playwright.playwright",
                    "ms-python.debugpy",
                    "ms-python.python",
                    "ms-python.vscode-pylance",
                    "ms-python.vscode-python-envs",
                    "ms-vscode-remote.remote-containers",
                    "ms-vscode.makefile-tools",
                    "ms-vscode.powershell",
                    "redhat.vscode-yaml",
                    "rust-lang.rust-analyzer",
                    "streetsidesoftware.code-spell-checker",
                    "timonwong.shellcheck",
                    "yzhang.markdown-all-in-one"
                ],
                "block": [
                    "eg2.vscode-npm-script",
                    "hookyqr.beautify",
                    "ms-azuretools.vscode-docker",
                    "ms-python.autopep8",
                    "ms-python.black-formatter",
                    "ms-python.flake8",
                    "ms-python.isort",
                    "ms-python.pylint",
                    "ms-vscode.node-debug2",
                    "ms-vscode.powershell-preview",
                    "ms-vscode.vscode-typescript-tslint-plugin"
                ]
            },
            "settings": {
                "agents.voice.enabled": false,
                "agents.voice.showButton": false,
                "chat.defaultModel": "auto",
                "chat.defaultToCopilotHarness": true,
                "chat.editor.preferCopilotHarness": true,
                "chat.newSession.defaultMode": "agent",
                "chat.requestQueuing.defaultAction": "queue",
                "chat.sessionSync.enabled": true,
                "chat.tools.terminal.enforceTimeoutFromModel": true,
                "chat.tools.terminal.idleSilenceTimeoutMs": 60000,
                "chat.tools.terminal.outputLocation": "terminal",
                "dictation.enabled": false,
                "dictation.showButton": false,
                "github.copilot.chat.autoModeTierOverride": "balance",
                "github.copilot.chat.localIndex.enabled": true,
                "diffEditor.maxComputationTime": 0,
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "editor.formatOnSave": true,
                "extensions.autoCheckUpdates": true,
                "extensions.autoUpdate": true,
                "explorer.confirmDelete": true,
                "explorer.confirmDragAndDrop": false,
                "explorer.confirmPasteNative": false,
                "git.autofetch": true,
                "git.confirmSync": false,
                "git.enableSmartCommit": true,
                "git.ignoreRebaseWarning": true,
                "git.replaceTagsWhenPull": true,
                "githubPullRequests.pullBranch": "never",
                "makefile.configureOnOpen": true,
                "markdown.extension.completion.enabled": true,
                "markdown.extension.preview.autoShowPreviewToSide": true,
                "python.analysis.typeCheckingMode": "strict",
                "python.terminal.activateEnvironment": true,
                "redhat.telemetry.enabled": false,
                "rust-analyzer.check.command": "clippy",
                "[rust]": {
                    "editor.defaultFormatter": "rust-lang.rust-analyzer",
                    "editor.formatOnSave": true
                },
                "remote.autoForwardPortsSource": "hybrid",
                "security.workspace.trust.banner": "always",
                "security.workspace.trust.startupPrompt": "always",
                "settingsSync.ignoredSettings": [
                    "php.validate.executablePath",
                    "powershell.powerShellAdditionalExePaths",
                    "yaml.schemas"
                ],
                "settingsSync.keybindingsPerPlatform": false,
                "terminal.integrated.enableMultiLinePasteWarning": "never",
                "terminal.integrated.enablePersistentSessions": false,
                "terminal.integrated.hideOnStartup": "never",
                "terminal.integrated.persistentSessionReviveProcess": "never",
                "terminal.integrated.shellIntegration.enabled": true,
                "update.showReleaseNotes": false,
                "window.confirmSaveUntitledWorkspace": false,
                "window.confirmBeforeClose": "always",
                "workbench.startupEditor": "none",
                "yaml.disableSchemaDetection": [
                    "**/.github/workflows/*.yml",
                    "**/.github/workflows/*.yaml",
                    "**/.gitea/workflows/*.yml",
                    "**/.gitea/workflows/*.yaml",
                    "**/.forgejo/workflows/*.yml",
                    "**/.forgejo/workflows/*.yaml"
                ]
            }
        },
        "mcp": {
            "manage": true,
            "removeBlocked": false,
            "copilotConfig": {
                "manage": true
            },
            "servers": {
                "io.github.github/github-mcp-server": {
                    "type": "http",
                    "url": "https://api.githubcopilot.com/mcp/"
                },
                "microsoftdocs/mcp": {
                    "type": "http",
                    "url": "https://learn.microsoft.com/api/mcp"
                },
                "microsoft/markitdown": {
                    "type": "stdio",
                    "command": "uvx",
                    "args": ["markitdown-mcp@0.0.1a8"]
                },
                "microsoft/playwright-mcp": {
                    "type": "stdio",
                    "command": "npx",
                    "args": ["--yes", "@playwright/mcp@0.0.83"]
                }
            },
            "inputs": [],
            "block": []
        },
        "devcontainers": {
            "dockerAccess": "outside-of-docker",
            "baseImage": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
            "remoteUser": "vscode",
            "features": {
                "ghcr.io/devcontainers/features/common-utils:2": {
                    "installZsh": true,
                    "configureZshAsDefaultShell": false,
                    "upgradePackages": true
                },
                "ghcr.io/devcontainers/features/git:1": {},
                "ghcr.io/devcontainers/features/github-cli:1": {}
            },
            "extensions": [
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "GitHub.vscode-pull-request-github",
                "GitHub.vscode-github-actions",
                "charliermarsh.ruff",
                "dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "editorconfig.editorconfig",
                "esbenp.prettier-vscode",
                "davidanson.vscode-markdownlint",
                "hashicorp.hcl",
                "ms-playwright.playwright",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.vscode-python-envs",
                "ms-vscode.makefile-tools",
                "ms-vscode.powershell",
                "redhat.vscode-yaml",
                "rust-lang.rust-analyzer",
                "streetsidesoftware.code-spell-checker",
                "yzhang.markdown-all-in-one",
                "timonwong.shellcheck"
            ],
            "settings": {
                "dev.containers.copyGitConfig": true,
                "dev.containers.gitCredentialHelperConfigLocation": "system",
                "dev.containers.cacheVolume": true,
                "dev.containers.logLevel": "info"
            }
        }
    },
    "advanced": {
        "git": {
            "defaultInstallDir": "%USERPROFILE%\\PortableGit",
            "portableReleaseApiUrl": "https://api.github.com/repos/git-for-windows/git/releases/latest",
            "portableAssetPattern": "PortableGit-*64-bit.7z.exe",
            "homebrewFormula": "git",
            "homebrewInstallUrl": "https://github.com/Homebrew/brew/archive/refs/heads/master.tar.gz",
            "linuxbrewShellenv": "$HOME/.linuxbrew/bin/brew",
            "credential": {
                "windows": {
                    "helper": "manager",
                    "credentialStore": "wincredman",
                    "guiPrompt": false
                },
                "macos": {
                    "helper": "osxkeychain"
                },
                "linux": {
                    "helper": "manager"
                }
            }
        },
        "githubCli": {
            "homebrewFormula": "gh",
            "wingetPackageId": "GitHub.cli",
            "portableInstallDir": "%LOCALAPPDATA%\\Programs\\GitHub CLI",
            "portableReleaseApiUrl": "https://api.github.com/repos/cli/cli/releases/latest",
            "windowsSearchPaths": [
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\gh.exe",
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\bin\\gh.exe",
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\*\\bin\\gh.exe",
                "%LOCALAPPDATA%\\Programs\\GitHub CLI\\gh.exe",
                "%LOCALAPPDATA%\\Programs\\GitHub CLI\\bin\\gh.exe",
                "%ProgramFiles%\\GitHub CLI\\gh.exe",
                "%ProgramFiles%\\GitHub CLI\\bin\\gh.exe"
            ]
        },
        "python": {
            "wingetPackageId": "Python.Python.{version}",
            "windowsInstallRoot": "%LOCALAPPDATA%\\Programs\\Python",
            "uvInstallUrl": {
                "windows": "https://astral.sh/uv/install.ps1",
                "unix": "https://astral.sh/uv/install.sh"
            },
            "uvWindowsPath": "%USERPROFILE%\\.local\\bin\\uv.exe"
        },
        "node": {
            "wingetPackageId": "OpenJS.NodeJS.LTS",
            "portableBaseUrl": "https://nodejs.org/dist",
            "portableInstallDir": "%LOCALAPPDATA%\\Programs\\nodejs",
            "homebrewFormula": "node",
            "windowsSearchPaths": [
                "%ProgramFiles%\\nodejs\\node.exe",
                "%LOCALAPPDATA%\\Programs\\nodejs\\node.exe",
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}*\\node-v*\\node.exe"
            ]
        },
        "prettier": {
            "npmPackage": "prettier",
            "npmPackageSpec": "prettier@latest",
            "windowsGlobalPrefix": "%USERPROFILE%\\.npm-global",
            "unixGlobalPrefix": "$HOME/.npm-global"
        },
        "rust": {
            "homebrewFormula": "rustup",
            "wingetPackageId": "Rustlang.Rustup",
            "bootstrapBaseUrl": "https://static.rust-lang.org/rustup/dist"
        },
        "dioxus": {
            "cargoPackage": "dioxus-cli",
            "cratesApiBaseUrl": "https://crates.io/api/v1/crates"
        },
        "php": {
            "homebrewFormula": "php",
            "wingetPackageId": "PHP.PHP.8.5",
            "windowsSearchPaths": [
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\php.exe"
            ]
        },
        "powershell": {
            "homebrewFormula": "powershell",
            "wingetPackageId": "Microsoft.PowerShell",
            "portableReleaseApiUrl": "https://api.github.com/repos/PowerShell/PowerShell/releases/latest",
            "portableInstallDir": "%LOCALAPPDATA%\\Programs\\PowerShell"
        },
        "shellcheck": {
            "homebrewFormula": "shellcheck",
            "wingetPackageId": "koalaman.shellcheck",
            "windowsSearchPaths": [
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\shellcheck.exe"
            ]
        },
        "ripgrep": {
            "homebrewFormula": "ripgrep",
            "wingetPackageId": "BurntSushi.ripgrep.MSVC",
            "windowsSearchPaths": [
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\rg.exe"
            ]
        },
        "busybox": {
            "wingetPackageId": "frippery.busybox-w32",
            "windowsSearchPaths": [
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Links\\busybox.exe",
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\busybox*.exe"
            ]
        },
        "packer": {
            "homebrewFormula": "hashicorp/tap/packer",
            "wingetPackageId": "Hashicorp.Packer",
            "windowsSearchPaths": [
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Links\\packer.exe",
                "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\{wingetPackageId}_*\\packer.exe"
            ]
        },
        "gpg": {
            "homebrewFormula": "gnupg",
            "portableGitRelativePath": "usr\\bin\\gpg.exe",
            "keyExpiry": "2y"
        },
        "vscode": {
            "profileDirectories": {
                "windows": {
                    "stable": "%APPDATA%\\Code\\User",
                    "insiders": "%APPDATA%\\Code - Insiders\\User"
                },
                "macos": {
                    "stable": "$HOME/Library/Application Support/Code/User",
                    "insiders": "$HOME/Library/Application Support/Code - Insiders/User"
                },
                "linux": {
                    "stable": "$HOME/.config/Code/User",
                    "insiders": "$HOME/.config/Code - Insiders/User"
                }
            },
            "managedSettingKeys": {
                "gitPath": "git.path",
                "pythonInterpreter": "python.defaultInterpreterPath",
                "pythonGlobalModuleInstallation": "python.globalModuleInstallation",
                "phpValidator": "php.validate.executablePath",
                "powerShellAdditionalExePaths": "powershell.powerShellAdditionalExePaths"
            },
            "settingsSync": {
                "stateDbRelativePath": "globalStorage/state.vscdb",
                "enabledKey": "sync.enable",
                "accountProviderKey": "userDataSyncAccountProvider",
                "accountPreferenceKey": "userDataSyncAccountPreference",
                "syncCliArgs": ["--sync", "on"]
            },
            "extensionCli": {
                "stable": "code",
                "insiders": "code-insiders"
            },
            "extensionCliFallbackPaths": {
                "stable": {
                    "macos": [
                        "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
                        "$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
                    ],
                    "linux": [
                        "/usr/share/code/bin/code",
                        "/usr/bin/code",
                        "/snap/bin/code",
                        "/var/lib/flatpak/exports/bin/com.visualstudio.code"
                    ]
                },
                "insiders": {
                    "macos": [
                        "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code-insiders",
                        "$HOME/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code-insiders"
                    ],
                    "linux": [
                        "/usr/share/code-insiders/bin/code-insiders",
                        "/usr/bin/code-insiders",
                        "/snap/bin/code-insiders"
                    ]
                }
            },
            "mcpFileName": "mcp.json",
            "settings": {
                "azureFunctions.showProjectWarning": false
            }
        },
        "devcontainers": {
            "dockerAccessFeatures": {
                "outside-of-docker": {
                    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
                        "moby": false,
                        "installDockerBuildx": true,
                        "installDockerComposeSwitch": true
                    }
                },
                "in-docker": {
                    "ghcr.io/devcontainers/features/docker-in-docker:2": {
                        "moby": false,
                        "installDockerBuildx": true,
                        "installDockerComposeSwitch": true
                    }
                },
                "none": {}
            },
            "settingKeys": {
                "features": "dev.containers.defaultFeatures",
                "extensions": "dev.containers.defaultExtensions"
            },
            "snippet": {
                "file": "jsonc.json",
                "name": "Dev container (Ubuntu base)",
                "prefix": "devcontainer"
            }
        }
    }
}
